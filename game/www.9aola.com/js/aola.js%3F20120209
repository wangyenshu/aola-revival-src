    }

	function getSN() {
        if (document.referrer == null) return "";       
        var domain = document.referrer.split('/')[2];
        var domainParts = domain.split('.');
        return domainParts.length == 2 ? domainParts[0] : domainParts[1];          
    }
    
    function getRef() { 
	    return document.referrer; 
	}

