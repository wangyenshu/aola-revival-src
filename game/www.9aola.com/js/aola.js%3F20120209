    function addFav(key) {
        try
        {
            window.external.addFavorite("http://www.9aola.com/?fav=" + key  ,"奥拉星-奇趣奥拉星，你我快乐行");
        }
        catch (e)
        {
            try{
                window.external.addToFavoritesBar("http://www.9aola.com/?fav=" + key  ,"奥拉星-奇趣奥拉星，你我快乐行", "slice");    
            }
            catch(e)
            {
                try
                {
                    window.sidebar.addPanel("奥拉星-奇趣奥拉星，你我快乐行","http://www.9aola.com/?fav=" + key  , "");
                }
                catch (e)
                {
                    alert("非常抱歉，你的浏览器目前还不支持此功能！请在浏览器的收藏夹或书签菜单里进行手动添加。");
                }
            }
        }
        
        return "callsuccess";
    }
        
