function getQS(key)
{
    var search = window.location.search;
    if (search == "" || search == "?")
    {
        return null;
    }
    var qs = window.location.search.substring(1);    
    var kvItems = qs.split("&");
    var kv;
    for (i=0; i < kvItems.length; i++) 
    {
        kv =  kvItems[i].split("=");
        if (kv[0] == key)
       {
            return kv.length == 1 ? "" : kv[1];
        }
    }
}

function getU()
{
    return getQS("u");	    
}
	
function getCode()
{
    return getQS("code");
}
	
function isReg()
{
   return getQS("reg") !=  null;
}